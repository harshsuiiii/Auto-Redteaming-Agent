# AutoRedTeam — environment configuration (copy to `.env` and fill in; NEVER commit `.env`)

# ─── LLM provider (OpenAI-compatible) ───────────────────────────────────────
# This project runs on Groq (an OpenAI-compatible endpoint). Use ONE of the keys below.
GROQ_API_KEY=your_groq_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here

# Point the OpenAI-compatible client at the provider + model:
AUTOREDTEAM_LLM_BASE_URL=https://api.groq.com/openai/v1
AUTOREDTEAM_LLM_MODEL=openai/gpt-oss-120b

# ─── Optional ───────────────────────────────────────────────────────────────
# Exercise the agent plumbing WITHOUT a real LLM call (standalone scripts only):
# AUTOREDTEAM_STUB_LLM=1

# OWASP ZAP comparison baseline (only when a ZAP daemon is reachable):
# ZAP_API_URL=http://127.0.0.1:8090

# Disable ChromaDB telemetry (set automatically by the code, listed here for clarity):
# ANONYMIZED_TELEMETRY=False
